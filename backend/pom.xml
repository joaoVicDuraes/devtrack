<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot parent POM.
        Inheriting from spring-boot-starter-parent gives us:
          - Sensible, tested dependency versions (so most dependencies below need no <version>).
          - Plugin configuration for building an executable jar.
        The version here pins the whole Spring Boot line for the project.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/> <!-- look the parent up from the Maven repository, not a local path -->
    </parent>

    <groupId>com.devtrack</groupId>
    <artifactId>devtrack-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>devtrack-backend</name>
    <description>DevTrack task management REST API</description>

    <properties>
        <!-- Target Java 21 for both compilation and the bytecode level. -->
        <java.version>21</java.version>
        <!-- jqwik is not managed by the Spring Boot parent, so we pin its version here. -->
        <jqwik.version>1.9.1</jqwik.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Web layer: REST controllers, JSON (Jackson), embedded Tomcat. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence layer: Spring Data JPA + Hibernate. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation (used later for @Valid on request DTOs). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MySQL JDBC driver. Runtime scope: needed to run, not to compile against. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot test support: JUnit 5, AssertJ, Mockito, Spring test context. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            H2: an in-memory SQL database, test scope only.
            @DataJpaTest boots a real JPA/Hibernate layer but, by convention, swaps the
            configured MySQL datasource for a fast embedded database. H2 fills that role so the
            persistence-wiring integration test runs without a live MySQL server. The Task entity
            uses only portable JPA features (IDENTITY id generation, VARCHAR columns, enums stored
            by name), so H2 exercises the same mapping the app uses against MySQL.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            jqwik: property-based testing engine for JUnit 5.
            Test scope only. Used later to implement Properties 1-12 from the design.
        -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Repackages the app into an executable jar and enables `mvn spring-boot:run`. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
